#!/usr/bin/env bash
#===============================================================================
#  WaterWall-Test — full test suite for GoldWaterTunnel (client and server)
#===============================================================================
ENV_FILE="/etc/goldwater/env"
[ -f "$ENV_FILE" ] && . "$ENV_FILE" || { echo "GoldWaterTunnel is not installed here"; exit 1; }

ROLE="${GWT_ROLE:-client}"
PASS=0; FAIL=0
C_Green='\033[0;32m'; C_Red='\033[0;31m'; C_Yellow='\033[1;33m'; C_Cyan='\033[0;36m'; C_Off='\033[0m'
hr()  { echo -e "${C_Cyan}────────────────────────────────────────────────────────${C_Off}"; }
tp()  { PASS=$((PASS+1)); echo -e "  ${C_Green}[PASS]${C_Off} $*"; }
tf()  { FAIL=$((FAIL+1)); echo -e "  ${C_Red}[FAIL]${C_Off} $*"; }
ti()  { echo -e "  ${C_Yellow}[INFO]${C_Off} $*"; }

echo -e "${C_Cyan}"
echo "╔════════════════════════════════════════════════════════╗"
echo "║          WaterWall-Test  ·  GoldWaterTunnel            ║"
echo "╚════════════════════════════════════════════════════════╝"
echo -e "${C_Off}"
echo "  role=${ROLE}  version=${GWT_VERSION:-?}  date=$(date '+%F %T')"
hr; echo " 1) SERVICES"; hr

svc_check() {
  if systemctl is-active --quiet "$1"; then tp "$1 is active (uptime: $(systemctl show -p ActiveEnterTimestamp --value "$1" | cut -d' ' -f2))"
  else tf "$1 is NOT active"; fi
}
svc_check waterwall
if [ "$ROLE" = "client" ]; then
  svc_check goldwater-watchdog 2>/dev/null || tf "goldwater-watchdog is NOT active"
fi

hr; echo " 2) LISTENING PORTS"; hr
port_listen_tcp() { ss -tlnH "sport = :$2" 2>/dev/null | grep -q LISTEN; }
port_listen_udp() { ss -ulnH "sport = :$2" 2>/dev/null | grep -q UNCONN; }

if [ "$ROLE" = "server" ]; then
  port_listen_tcp "${GWT_PORT:-443}" && tp "TCP:${GWT_PORT:-443} listening" || tf "TCP:${GWT_PORT:-443} NOT listening"
else
  port_listen_udp "${GWT_WG_PORT:-51820}" && tp "UDP:${GWT_WG_PORT:-51820} (WireGuard endpoint) listening" || tf "UDP:${GWT_WG_PORT:-51820} NOT listening"
  port_listen_tcp "${GWT_TEST_SOCKS:-40000}" && tp "TCP:${GWT_TEST_SOCKS:-40000} (test socks) listening" || tf "TCP:${GWT_TEST_SOCKS:-40000} NOT listening"
fi

hr; echo " 3) DIRECT INTERNET (no tunnel)"; hr
d_ip="$(curl -s -m 10 https://api.ipify.org 2>/dev/null || echo n/a)"
[ "$d_ip" != "n/a" ] && tp "direct internet works (egress IP: $d_ip)" || tf "no direct internet from this server"

if [ "$ROLE" = "server" ]; then
  hr; echo " 4) TUNNEL PORT REACHABILITY + LOAD"; hr
  est="$(ss -tnH state established "( sport = :${GWT_PORT:-443} )" 2>/dev/null | wc -l)"
  ti "established client connections on port ${GWT_PORT:-443}: $est"
  [ "$est" -ge 0 ] && tp "listener accepting connections"

  hr; echo " 5) EXIT THROUGHput (direct)"; hr
  speed="$(curl -s -m 60 -o /dev/null -w '%{speed_download}' "https://speed.cloudflare.com/__down?bytes=26214400" 2>/dev/null || echo 0)"
  mbps=$(awk -v s="$speed" 'BEGIN{printf "%.1f", s*8/1000000}')
  ti "direct download: ${mbps} Mbit/s"

  hr; echo " 6) LOG ERRORS (last 5)"; hr
  grep -iE "error|fatal|panic" /var/log/goldwater/core.*.log 2>/dev/null | tail -5 | sed 's/^/  /' || ti "no errors in core.log"

  hr; echo " 7) RESOURCES"; hr
  ps -o pid,pcpu,pmem,rss,etime,comm -C waterwall --no-headers 2>/dev/null | while read -r pid pcpu pmem rss et comm; do
    ti "waterwall pid=$pid cpu=${pcpu}% mem=${pmem}% rss=$((rss/1024))MB uptime=$et"
  done
  echo
  echo -e "${C_Green} RESULT: PASS=$PASS FAIL=$FAIL${C_Off}"
  [ "$FAIL" = "0" ] && echo -e "${C_Green} All good — server side is healthy.${C_Off}"
  exit "$FAIL"
fi

#──────────────────────────── CLIENT TESTS ───────────────────────────────────

hr; echo " 4) TUNNEL END-TO-END (socks -> fisher -> reality -> server -> internet)"; hr
lat="$(curl -s -m 15 --socks5-hostname "127.0.0.1:${GWT_TEST_SOCKS:-40000}" -o /tmp/gwt-ip -w '%{time_total}' https://api.ipify.org 2>/dev/null || echo 0)"
t_ip="$(cat /tmp/gwt-ip 2>/dev/null || echo n/a)"
if [ "$t_ip" = "${GWT_EXPECTED_EXIT}" ]; then
  tp "exit IP = $t_ip (expected ${GWT_EXPECTED_EXIT}) — full request latency ${lat}s"
else
  tf "exit IP = '$t_ip' but expected '${GWT_EXPECTED_EXIT}' (tunnel broken or server changed)"
fi

warm="$(curl -s -m 15 --socks5-hostname "127.0.0.1:${GWT_TEST_SOCKS:-40000}" -o /dev/null -w '%{time_total}' https://api.ipify.org 2>/dev/null || echo 0)"
ti "warm request latency: ${warm}s"

hr; echo " 5) WIREGUARD PATH (xray-style handshake -> wg -> tunnel)"; hr
if command -v wireproxy >/dev/null 2>&1 && [ -f /etc/goldwater/wg-test.conf ]; then
  wgtest_ip="$(wireproxy -c /etc/goldwater/wg-test.conf >/tmp/wireproxy-test.log 2>&1 &
    wpid=$!
    for i in $(seq 1 15); do sleep 1; port_listen_tcp 40099 && break; done
    curl -s -m 15 --socks5-hostname 127.0.0.1:40099 https://api.ipify.org 2>/dev/null || echo n/a
    kill $wpid 2>/dev/null; wait $wpid 2>/dev/null)"
  if [ "$wgtest_ip" = "${GWT_EXPECTED_EXIT}" ]; then
    tp "WireGuard path OK — exit IP $wgtest_ip (full chain verified)"
  else
    tf "WireGuard path returned '$wgtest_ip' (expected ${GWT_EXPECTED_EXIT})"
  fi
else
  ti "wireproxy not installed — skipping (install: https://github.com/octeep/wireproxy)"
fi

hr; echo " 6) THROUGHPUT THROUGH TUNNEL (25 MB)"; hr
spd="$(curl -s -m 90 --socks5-hostname "127.0.0.1:${GWT_TEST_SOCKS:-40000}" -o /dev/null -w '%{speed_download}' "https://speed.cloudflare.com/__down?bytes=26214400" 2>/dev/null || echo 0)"
mbps=$(awk -v s="$spd" 'BEGIN{printf "%.1f", s*8/1000000}')
ti "tunnel download: ${mbps} Mbit/s"
awk -v m="$mbps" 'BEGIN{exit !(m>5)}' && tp "throughput > 5 Mbit/s" || tf "throughput too low (${mbps} Mbit/s)"

hr; echo " 7) CONCURRENT LOAD (20 parallel requests)"; hr
tmpd="$(mktemp -d)"
for i in $(seq 1 20); do
  ( curl -s -m 25 --socks5-hostname "127.0.0.1:${GWT_TEST_SOCKS:-40000}" -o /dev/null -w '%{http_code}' \
      https://api.ipify.org 2>/dev/null > "$tmpd/$i" ) &
done
wait
okcnt=$(grep -l '^200$' "$tmpd"/* 2>/dev/null | wc -l)
rm -rf "$tmpd"
ti "success: $okcnt/20"
[ "$okcnt" -ge 18 ] && tp "concurrency test passed ($okcnt/20)" || tf "concurrency low ($okcnt/20)"

hr; echo " 8) WATCHDOG"; hr
if [ -f /var/lib/goldwater/watchdog.pid ] && kill -0 "$(cat /var/lib/goldwater/watchdog.pid)" 2>/dev/null; then
  tp "watchdog process alive (pid $(cat /var/lib/goldwater/watchdog.pid))"
else
  tf "watchdog process not running"
fi
last_status="$(cat /var/lib/goldwater/last_status 2>/dev/null || echo '?')"
[ "$last_status" = "1" ] && tp "watchdog last probe: HEALTHY" || ti "watchdog last probe value: $last_status"
ti "recent watchdog log:"
tail -5 /var/log/goldwater/watchdog.log 2>/dev/null | sed 's/^/    /'

hr; echo " 9) X-UI PANEL OUTBOUND"; hr
if command -v sqlite3 >/dev/null 2>&1 && [ -f /etc/x-ui/x-ui.db ]; then
  if sqlite3 -readonly /etc/x-ui/x-ui.db "select value from settings where key='xrayTemplateConfig';" 2>/dev/null | grep -q waterwall-wg; then
    tp "x-ui xray template contains 'waterwall-wg' outbound"
  else
    ti "x-ui template does not reference 'waterwall-wg' yet (see README: add the outbound)"
  fi
else
  ti "x-ui not found / sqlite3 missing — skipped"
fi

hr; echo " 10) LOG ERRORS (last 5)"; hr
grep -iE "error|fatal|panic" /var/log/goldwater/core.*.log 2>/dev/null | tail -5 | sed 's/^/  /' || ti "no errors in core.log"

hr; echo " 11) RESOURCES"; hr
ps -o pid,pcpu,pmem,rss,etime,comm -C waterwall --no-headers 2>/dev/null | while read -r pid pcpu pmem rss et comm; do
  ti "waterwall pid=$pid cpu=${pcpu}% mem=${pmem}% rss=$((rss/1024))MB uptime=$et"
done
sysctl net.core.rmem_max net.ipv4.tcp_congestion_control 2>/dev/null | sed 's/^/  /'

echo
hr
echo -e "  RESULT: ${C_Green}PASS=$PASS${C_Off}  ${C_Red}FAIL=$FAIL${C_Off}"
if [ "$FAIL" = "0" ]; then
  echo -e "  ${C_Green}All tests passed — tunnel is healthy and anti-DPI chain verified.${C_Off}"
else
  echo -e "  ${C_Yellow}Failures detected. Check: systemctl status waterwall | journalctl -u waterwall -n 50${C_Off}"
fi
exit "$FAIL"
